#!/usr/bin/env bash
#
# git worktree add で作成された作業ツリーに、
# メインリポジトリ root の .envrc* の symlink を張る。
#
# post-checkout は worktree add 以外の checkout でも呼ばれるが、
# 対象を linked worktree に限定し、既存ファイルは上書きしない。

set -u
shopt -s nullglob

link_envrc() {
	local worktree_root main_root src name dest
	worktree_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
	[ -n "$worktree_root" ] || return 0

	# worktree list の先頭がメイン作業ツリー
	main_root=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0, 10); exit}')
	[ -n "$main_root" ] || return 0

	# メイン作業ツリー自身での checkout なら何もしない
	[ "$main_root" != "$worktree_root" ] || return 0

	for src in "$main_root"/.envrc*; do
		[ -f "$src" ] || continue
		name=${src##*/}
		dest="$worktree_root/$name"
		if [ -e "$dest" ] || [ -L "$dest" ]; then
			continue
		fi
		if ln -s "$src" "$dest"; then
			echo "post-checkout: linked $name -> $src" >&2
		fi
	done
}

link_envrc

# リポジトリ固有の hook (lefthook/husky など) があれば委譲する
HOOK_NAME=post-checkout exec "$(dirname "$0")/_local-hook-dispatch" "$@"
