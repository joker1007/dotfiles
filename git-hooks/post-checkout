#!/usr/bin/env bash
#
# git worktree add で作成された作業ツリーに、
# メインリポジトリ root のローカル設定ファイルの symlink を張る。
#
# post-checkout は worktree add 以外の checkout でも呼ばれるが、
# 対象を linked worktree に限定し、既存ファイルは上書きしない。

set -u
shopt -s nullglob

# symlink 対象 (メインリポジトリ root からの glob パターン)
LINK_PATTERNS=(
	'.envrc*'
	'CLAUDE.local.md'
)

link_local_files() {
	local worktree_root main_root pattern src name dest
	worktree_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
	[ -n "$worktree_root" ] || return 0

	# worktree list の先頭がメイン作業ツリー
	main_root=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0, 10); exit}')
	[ -n "$main_root" ] || return 0

	# メイン作業ツリー自身での checkout なら何もしない
	[ "$main_root" != "$worktree_root" ] || return 0

	for pattern in "${LINK_PATTERNS[@]}"; do
		for src in "$main_root"/$pattern; do
			[ -f "$src" ] || continue
			name=${src##*/}
			dest="$worktree_root/$name"
			if [ -e "$dest" ] || [ -L "$dest" ]; then
				continue
			fi
			if ln -s "$src" "$dest"; then
				echo "post-checkout: linked $name -> $src" >&2
			fi
		done
	done

	allow_direnv "$main_root" "$worktree_root"
}

# direnv の allowed 状態 (0: allowed, 1: not allowed, 2: denied)。
# 親ディレクトリの .envrc にマッチした場合は対象外として空を返す。
direnv_allowed_status() {
	local dir=$1
	(cd "$dir" && direnv status --json 2>/dev/null) |
		jq -r --arg rc "$dir/.envrc" 'select(.state.foundRC.path == $rc) | .state.foundRC.allowed' 2>/dev/null
}

# メイン作業ツリーで direnv allow 済みなら worktree でも allow する
allow_direnv() {
	local main_root=$1 worktree_root=$2
	command -v direnv >/dev/null 2>&1 || return 0
	command -v jq >/dev/null 2>&1 || return 0
	[ -f "$main_root/.envrc" ] && [ -f "$worktree_root/.envrc" ] || return 0

	[ "$(direnv_allowed_status "$main_root")" = 0 ] || return 0
	[ "$(direnv_allowed_status "$worktree_root")" != 0 ] || return 0

	if direnv allow "$worktree_root" >/dev/null 2>&1; then
		echo "post-checkout: direnv allow $worktree_root" >&2
	fi
}

link_local_files

# リポジトリ固有の hook (lefthook/husky など) があれば委譲する
HOOK_NAME=post-checkout exec "$(dirname "$0")/_local-hook-dispatch" "$@"
